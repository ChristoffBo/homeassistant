{
  "name": "WG Easy",
  "version": "15.4.0",
  "slug": "wgeasy",
  "description": "WireGuard VPN with a web UI (wg-easy 15)",
  "url": "https://github.com/ChristoffBo/homeassistant",
  "startup": "services",
  "boot": "auto",
  "init": false,
  "arch": [
    "amd64",
    "aarch64"
  ],
  "ports": {
    "51820/udp": 51820,
    "51821/tcp": 51821
  },
  "ports_description": {
    "51820/udp": "WireGuard: forward this port in your router",
    "51821/tcp": "Web UI"
  },
  "webui": "http://[HOST]:[PORT:51821]",
  "panel_icon": "mdi:vpn",
  "privileged": [
    "NET_ADMIN",
    "SYS_MODULE"
  ],
  "kernel_modules": true,
  "devices": [
    "/dev/net/tun"
  ],
  "options": {
    "insecure": true,
    "disable_ipv6": false
  },
  "schema": {
    "insecure": "bool",
    "disable_ipv6": "bool"
  }
}
